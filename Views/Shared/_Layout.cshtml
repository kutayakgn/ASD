<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Afife Yönetim</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/complex-table.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ticket-fee-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/blacklist.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/voting-history.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-management.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/plays.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/rankings.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/applications.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/generic-popup.css" asp-append-version="true" />
</head>
<body>
    @await Component.InvokeAsync("Header")

    <main class="container-fluid admin-main">
        @RenderBody()
    </main>

    @await Component.InvokeAsync("GenericPopup")
    <div data-complex-table-modal-host></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/complex-table.js" asp-append-version="true"></script>
    <script src="~/js/complex-table-modal.js" asp-append-version="true"></script>
    <script src="~/js/ticket-fee-form.js" asp-append-version="true"></script>
    <script src="~/js/generic-popup.js" asp-append-version="true"></script>
    <script src="~/js/excel-export.js" asp-append-version="true"></script>
    <script src="~/js/complex-table-delete.js" asp-append-version="true"></script>
    <script src="~/js/complex-table-toggle.js" asp-append-version="true"></script>
    <script src="~/js/add-candidate.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>