@using System.Globalization
@model YKBAfife.Models.Components.ComplexTableViewModel
@{
    var activeTab = Model.Tabs.FirstOrDefault(x => x.Key == Model.CurrentTabKey)
        ?? Model.Tabs.FirstOrDefault();

    string NextSortDirection(string column) =>
        activeTab?.SortBy == column && activeTab.SortDirection == "asc" ? "desc" : "asc";

    string SortIndicator(string column) => activeTab?.SortBy == column
        ? activeTab.SortDirection == "asc" ? "↑" : "↓"
        : string.Empty;

    var startPage = activeTab is null ? 1 : Math.Max(1, activeTab.CurrentPage - 2);
    var endPage = activeTab is null ? 1 : Math.Min(activeTab.TotalPages, activeTab.CurrentPage + 2);
    var dataUrl = Url.Action(Model.DataActionName, Model.ControllerName);

    string ColumnWidth(int percentage)
    {
        var actionColumnsWidth = (Model.IsEditableRows ? Model.EditColumnWidth : 0) +
            (Model.IsDeleteColActive ? Model.DeleteColumnWidth : 0) +
            (Model.IsNavigationColActive ? Model.NavigationColumnWidth : 0);
        if (actionColumnsWidth == 0)
        {
            return $"{percentage}%";
        }

        var reservedWidth = actionColumnsWidth * percentage / 100m;
        return $"calc({percentage}% - {reservedWidth.ToString("0.##", CultureInfo.InvariantCulture)}px)";
    }
}

@if (activeTab is not null)
{
    <section id="@Model.Id"
             class="jury-voting-complex-table-section"
             aria-labelledby="@(Model.ShowHeading ? $"{Model.Id}-title" : null)"
             aria-label="@(!Model.ShowHeading ? activeTab.Title : null)"
             data-complex-table
             data-complex-table-url="@dataUrl">
        <form class="complex-table-state" data-complex-table-state>
            @Html.AntiForgeryToken()
            @foreach (var routeValue in Model.AdditionalRouteValues)
            {
                <input type="hidden" name="@routeValue.Key" value="@routeValue.Value" />
            }
            <input type="hidden" name="tab" value="@activeTab.Key" />
            <input type="hidden" name="sortBy" value="@activeTab.SortBy" />
            <input type="hidden" name="sortDirection" value="@activeTab.SortDirection" />
            <input type="hidden" name="page" value="@activeTab.CurrentPage" />

            @if (Model.Tabs.Count > 1)
            {
                <div class="jury-voting-tab-header" role="tablist" aria-label="Tablo grupları">
                    @foreach (var tab in Model.Tabs)
                    {
                        <button type="button"
                                class="jury-voting-tab-button @(tab.Key == activeTab.Key ? "active" : string.Empty)"
                                role="tab"
                                aria-selected="@(tab.Key == activeTab.Key ? "true" : "false")"
                                data-complex-table-action
                                data-tab="@tab.Key"
                                data-page="1">
                            @tab.Title
                        </button>
                    }
                </div>
            }
            @if (Model.ShowHeading || Model.ShowSearch || Model.SelectFilter is not null || activeTab.HeaderActions.Count > 0)
            {
                <div class="complex-table-heading">
                    @if (Model.ShowHeading)
                    {
                        <h2 id="@(Model.Id)-title">@activeTab.Title</h2>
                    }
                    <div class="complex-table-heading-tools">
                        @if (Model.SelectFilter is not null)
                        {
                            <div class="complex-table-select-filter">
                                <label for="@(Model.Id)-select-filter">@Model.SelectFilter.Label</label>
                                <div class="complex-table-select-filter-control">
                                    <select id="@(Model.Id)-select-filter"
                                            name="@Model.SelectFilter.Name"
                                            data-complex-table-filter>
                                        @foreach (var option in Model.SelectFilter.Options)
                                        {
                                            <option value="@option.Value" selected="@(option.Value == Model.SelectFilter.Value ? "selected" : null)">@option.Text</option>
                                        }
                                    </select>
                                    <img src="~/icons/angle-down.svg" alt="" aria-hidden="true" />
                                </div>
                            </div>
                        }
                        @if (Model.ShowSearch)
                        {
                            <div class="jury-voting-table-search-form">
                                <label class="visually-hidden" for="@(Model.Id)-search">@Model.SearchPlaceholder</label>
                                <input id="@(Model.Id)-search"
                                       type="search"
                                       name="search"
                                       value="@activeTab.Search"
                                       class="jury-voting-table-search-input"
                                       placeholder="@Model.SearchPlaceholder"
                                       autocomplete="off"
                                       data-complex-table-search />
                                <button type="button"
                                        class="complex-table-search-clear"
                                        aria-label="Aramay&#305; temizle"
                                        data-complex-table-clear>&times;</button>
                            </div>
                        }
                        @foreach (var action in activeTab.HeaderActions)
                        {
                            @if (action.IsButton)
                            {
                                <button type="button"
                                        class="complex-table-header-action @action.CssClass"
                                        aria-controls="@action.PanelTarget"
                                        aria-expanded="false"
                                        data-complex-table-panel-target="@action.PanelTarget">
                                    @if (!string.IsNullOrEmpty(action.Icon))
                                    {
                                        <img src="@action.Icon" alt="" aria-hidden="true" />
                                    }
                                    @action.Text
                                </button>
                            }
                            else
                            {
                                <a href="@action.Link" class="complex-table-header-action @action.CssClass">
                                    @if (!string.IsNullOrEmpty(action.Icon))
                                    {
                                        <img src="@action.Icon" alt="" aria-hidden="true" />
                                    }
                                    @action.Text
                                </a>
                            }
                        }
                    </div>
                </div>
            }
            </form>

        <div class="jury-voting-table-wrapper">
            <table class="jury-voting-table" style="--complex-table-min-width: @(Model.MinimumTableWidth)px; --complex-table-edit-width: @(Model.EditColumnWidth)px; --complex-table-delete-width: @(Model.DeleteColumnWidth)px; --complex-table-navigation-width: @(Model.NavigationColumnWidth)px;">
                <colgroup>
                    @foreach (var column in activeTab.Columns)
                    {
                        <col class="@column.CssClass" style="width: @ColumnWidth(column.ColWidth);" />
                    }
                    @if (Model.IsEditableRows)
                    {
                        <col class="complex-table-edit-col" />
                    }
                    @if (Model.IsDeleteColActive)
                    {
                        <col class="complex-table-delete-col" />
                    }
                    @if (Model.IsNavigationColActive)
                    {
                        <col class="complex-table-navigation-col" />
                    }
                </colgroup>
                @if (Model.ShowColumnHeaders)
                {
                    <thead>
                        <tr>
                            @foreach (var column in activeTab.Columns)
                            {
                                <th scope="col" class="@column.CssClass" style="width: @ColumnWidth(column.ColWidth);">
                                    @if (column.IsSortable)
                                    {
                                        <button type="button"
                                                class="jury-voting-sort-button"
                                                data-complex-table-action
                                                data-sort-by="@column.Key"
                                                data-sort-direction="@NextSortDirection(column.Key)"
                                                data-page="1">
                                            @column.Title <span aria-hidden="true">@SortIndicator(column.Key)</span>
                                        </button>
                                    }
                                    else
                                    {
                                        @column.Title
                                    }
                                </th>
                            }
                        @if (Model.IsEditableRows)
                            {
                                <th scope="col" class="complex-table-edit-column"></th>
                            }
                        @if (Model.IsDeleteColActive)
                            {
                                <th scope="col" class="complex-table-delete-column"></th>
                            }
                        @if (Model.IsNavigationColActive)
                            {
                                <th scope="col" class="complex-table-navigation-column"></th>
                            }
                        </tr>
                    </thead>
                }
                <tbody>
                    @if (activeTab.Rows.Count > 0)
                    {
                        foreach (var row in activeTab.Rows)
                        {
                            var isInteractiveRow = !string.IsNullOrWhiteSpace(row.Link) || !string.IsNullOrWhiteSpace(row.ModalUrl) || !string.IsNullOrWhiteSpace(row.DeleteUrl);
                            <tr id="@row.Id" class="@(isInteractiveRow ? "complex-table-linked-row" : string.Empty)"
                                data-row-link="@row.Link"
                                data-row-modal-url="@row.ModalUrl"
                                data-row-delete-url="@row.DeleteUrl"
                                data-delete-confirm-message="@row.DeleteConfirmMessage"
                                tabindex="@(isInteractiveRow ? "0" : null)"
                                role="@(!string.IsNullOrWhiteSpace(row.ModalUrl) || !string.IsNullOrWhiteSpace(row.DeleteUrl) ? "button" : !string.IsNullOrWhiteSpace(row.Link) ? "link" : null)">
                                @for (var index = 0; index < activeTab.Columns.Count; index++)
                                {
                                    var cell = index < row.Cells.Count ? row.Cells[index] : null;
                                    <td class="@activeTab.Columns[index].CssClass @((cell is not null && (!string.IsNullOrWhiteSpace(cell.Link) || !string.IsNullOrWhiteSpace(cell.ModalUrl))) ? "complex-table-action-cell" : string.Empty) @((cell is not null && !string.IsNullOrWhiteSpace(cell.ToggleUrl)) ? "complex-table-toggle-cell" : string.Empty)" style="width: @ColumnWidth(activeTab.Columns[index].ColWidth);">
                                        @if (cell is not null)
                                        {
                                            <div class="complex-table-cell-content @cell.CssClass">
                                                @if (!string.IsNullOrWhiteSpace(cell.ToggleUrl))
                                                {
                                                    <button type="button"
                                                            class="complex-table-toggle @(cell.ToggleChecked ? "is-active" : string.Empty)"
                                                            role="switch"
                                                            aria-checked="@(cell.ToggleChecked ? "true" : "false")"
                                                            aria-label="@cell.AccessibleLabel"
                                                            aria-disabled="@(cell.ToggleDisabled ? "true" : "false")"
                                                            disabled="@cell.ToggleDisabled"
                                                            data-complex-table-toggle-url="@cell.ToggleUrl"></button>
                                                }
                                                else if (!string.IsNullOrWhiteSpace(cell.Link))
                                                {
                                                    <a href="@cell.Link"
                                                       class="complex-table-cell-action"
                                                       aria-label="@(string.IsNullOrWhiteSpace(cell.AccessibleLabel) ? null : cell.AccessibleLabel)">@cell.Content</a>
                                                }
                                                else if (!string.IsNullOrWhiteSpace(cell.ModalUrl))
                                                {
                                                    <button type="button"
                                                            class="complex-table-cell-action complex-table-cell-button"
                                                            data-play-viewers-modal-url="@cell.ModalUrl"
                                                            aria-label="@(string.IsNullOrWhiteSpace(cell.AccessibleLabel) ? null : cell.AccessibleLabel)">@cell.Content</button>
                                                }
                                                else if (cell.IsHtml)
                                                {
                                                    @Html.Raw(cell.Content)
                                                }
                                                else
                                                {
                                                    @cell.Content
                                                }
                                            </div>
                                        }
                                    </td>
                                }
                                @if (Model.IsEditableRows)
                                {
                                    <td class="complex-table-edit-column">
                                        @if (!string.IsNullOrWhiteSpace(row.EditModalUrl))
                                        {
                                            <button type="button" class="complex-table-edit-button"
                                                    data-complex-table-modal-url="@row.EditModalUrl"
                                                    aria-label="@row.EditAccessibleLabel">
                                                <img src="~/icons/edit.svg" alt="" aria-hidden="true" />
                                            </button>
                                        }
                                    </td>
                                }
                                @if (Model.IsDeleteColActive)
                                {
                                    <td class="complex-table-delete-column">
                                        @if (!string.IsNullOrWhiteSpace(row.DeleteUrl))
                                        {
                                            <button type="button" class="complex-table-delete-button"
                                                    data-complex-table-delete-url="@row.DeleteUrl"
                                                    data-delete-confirm-message="@row.DeleteConfirmMessage"
                                                    aria-label="@row.DeleteAccessibleLabel">
                                                <img src="~/icons/trash.svg" alt="" aria-hidden="true" />
                                            </button>
                                        }
                                    </td>
                                }
                                @if (Model.IsNavigationColActive)
                                {
                                    <td class="complex-table-navigation-column">
                                        @if (!string.IsNullOrWhiteSpace(row.NavigationUrl))
                                        {
                                            <a href="@row.NavigationUrl" class="complex-table-navigation-link" aria-label="@row.NavigationAccessibleLabel">
                                                <img src="~/icons/angle-right-solid-full.svg" alt="" aria-hidden="true" />
                                            </a>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="@(activeTab.Columns.Count + (Model.IsEditableRows ? 1 : 0) + (Model.IsDeleteColActive ? 1 : 0) + (Model.IsNavigationColActive ? 1 : 0))" class="complex-table-empty">@activeTab.EmptyMessage</td></tr>
                    }
                </tbody>
            </table>
        </div>

       

        @if (Model.SummaryContent.Count > 0 || !string.IsNullOrWhiteSpace(Model.ExportActionName))
        {
            <div class="complex-table-summary-wrapper">
                <footer class="complex-table-summary">
                @if (Model.SummaryContent.Count > 0)
                {
                    <p class="complex-table-summary-content">
                        @foreach (var segment in Model.SummaryContent)
                        {
                            <span class="@segment.CssClass">
                                @if (segment.IsEmphasized)
                                {
                                    <strong>@segment.Text</strong>
                                }
                                else
                                {
                                    @segment.Text
                                }
                            </span>
                        }
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ExportActionName))
                {
                    <form method="post" action="@Url.Action(Model.ExportActionName, Model.ExportControllerName)" class="complex-table-export-form">
                        @Html.AntiForgeryToken()
                        @foreach (var routeValue in Model.AdditionalRouteValues)
                        {
                            <input type="hidden" name="@routeValue.Key" value="@routeValue.Value" />
                        }
                        <input type="hidden" name="tab" value="@activeTab.Key" />
                        <input type="hidden" name="search" value="@activeTab.Search" />
                        <input type="hidden" name="sortBy" value="@activeTab.SortBy" />
                        <input type="hidden" name="sortDirection" value="@activeTab.SortDirection" />
                        <input type="hidden" name="page" value="1" />
                        <button type="submit" class="excel-export-button" disabled="@(!Model.IsExportEnabled)" aria-disabled="@(!Model.IsExportEnabled ? "true" : "false")">
                            <span aria-hidden="true">↗</span> @Model.ExportButtonText
                        </button>
                    </form>
                }
            </footer></div>
            
        }
        @if (activeTab.TotalPages > 1)
        {
            <nav class="jury-voting-pagination" aria-label="Tablo sayfaları">
                <button type="button"
                        class="jury-voting-pagination-link jury-voting-pagination-arrow @(activeTab.CurrentPage == 1 ? "disabled":"")"
                        disabled="@(activeTab.CurrentPage == 1)"
                        aria-label="Önceki sayfa"
                        data-complex-table-action
                        data-page="@(activeTab.CurrentPage - 1)"><img src="icons/angle-left-solid-full.svg"></button>

                @if (startPage > 1)
                {
                    <button type="button" class="jury-voting-pagination-link" data-complex-table-action data-page="1">1</button>
                    @if (startPage > 2) { <span class="jury-voting-pagination-ellipsis">…</span> }
                }

                @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
                {
                    if (pageNumber == activeTab.CurrentPage)
                    {
                        <span class="jury-voting-pagination-current" aria-current="page">@pageNumber</span>
                    }
                    else
                    {
                        <button type="button" class="jury-voting-pagination-link" data-complex-table-action data-page="@pageNumber">@pageNumber</button>
                    }
                }

                @if (endPage < activeTab.TotalPages)
                {
                    @if (endPage < activeTab.TotalPages - 1) { <span class="jury-voting-pagination-ellipsis">…</span> }
                    <button type="button" class="jury-voting-pagination-link" data-complex-table-action data-page="@activeTab.TotalPages">@activeTab.TotalPages</button>
                }

                <button type="button"
                        class="jury-voting-pagination-link jury-voting-pagination-arrow @(activeTab.CurrentPage == activeTab.TotalPages ? "disabled":"")"
                        disabled="@(activeTab.CurrentPage == activeTab.TotalPages)"
                        aria-label="Sonraki sayfa"
                        data-complex-table-action
                        data-page="@(activeTab.CurrentPage + 1)"><img src="icons/angle-right-solid-full.svg"></button>
            </nav>
        }
    </section>
}