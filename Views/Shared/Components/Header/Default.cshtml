@model YKBAfife.Models.Components.HeaderViewModel
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isManagementPage = string.Equals(currentController, "Management", StringComparison.OrdinalIgnoreCase);
    var otherActions = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "Editors",
        "VotingHistory",
        "TicketSales",
        "PlayDates",
        "Blacklists",
        "VotingSettings",
        "ArchiveComparison"
    };

    string ActiveClass(string action) =>
        isManagementPage && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
            ? " active"
            : string.Empty;

    var isOtherActive = isManagementPage && currentAction is not null && otherActions.Contains(currentAction);
}

<header class="admin-header">
    <nav class="navbar navbar-expand-xl admin-navbar" aria-label="Ana menü">
        <div class="header-white-bar">
            <img src="~/icons/28-years.svg" alt="Afife 28. yıl" />
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="dropdown admin-user-dropdown">
                    <button class="admin-user-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span>@Model.UserFullName</span>
                        <svg class="admin-user-angle" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M3.5 6 8 10.5 12.5 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end admin-user-menu">
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Şifre Değiştir</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item admin-user-logout">Çıkış Yap</button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
        </div>
        <div class="container-fluid admin-nav-container">
            <a class="navbar-brand admin-logo" asp-controller="Home" asp-action="Index" aria-label="Afife Anasayfa">
                <img src="~/icons/afife-icon.svg" alt="Afife" />
            </a>
            <button class="navbar-toggler admin-menu-toggle" type="button" data-bs-toggle="collapse"
                    data-bs-target="#adminNavigation" aria-controls="adminNavigation"
                    aria-expanded="false" aria-label="Menüyü aç">
                <span></span><span></span><span></span>
            </button>
            <div class="collapse navbar-collapse" id="adminNavigation">
                <ul class="navbar-nav ms-auto align-items-xl-center admin-menu">
                    <li class="nav-item"><a class="nav-link@(ActiveClass("ArtPromise"))" asp-controller="Management" asp-action="ArtPromise">Sanata Sözümüz</a></li>
                    <li class="nav-item"><a class="nav-link@(ActiveClass("Juries"))" asp-controller="Management" asp-action="Juries">Jüriler</a></li>
                    <li class="nav-item"><a class="nav-link@(ActiveClass("Plays"))" asp-controller="Management" asp-action="Plays">Oyunlar</a></li>
                    <li class="nav-item"><a class="nav-link@(ActiveClass("Rankings"))" asp-controller="Management" asp-action="Rankings">Sıralamalar</a></li>
                    <li class="nav-item dropdown">
                        <button class="nav-link dropdown-toggle admin-dropdown-toggle@(isOtherActive ? " active" : string.Empty)" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span>Diğer</span>
                            <img class="admin-dropdown-angle" src="~/icons/angle-down-solid-full-white.svg" alt="" aria-hidden="true" />
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end admin-dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Management" asp-action="Editors">Editörler</a></li>
                            <li><a class="dropdown-item" asp-controller="Management" asp-action="VotingHistory">Oylama Geçmişi</a></li>
                            <li><a class="dropdown-item" asp-controller="Management" asp-action="TicketSales">Bilet Satışları</a></li>
                            <li><a class="dropdown-item" asp-controller="Management" asp-action="PlayDates">Oyun Tarihleri</a></li>
                            <li><a class="dropdown-item" asp-controller="Management" asp-action="Blacklists">Blacklists</a></li>
                            <li><a class="dropdown-item" asp-controller="Management" asp-action="VotingSettings">Oylama Ayarları</a></li>
                            <li><a class="dropdown-item" asp-controller="Management" asp-action="ArchiveComparison">Arşiv Karşılaştırma</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
