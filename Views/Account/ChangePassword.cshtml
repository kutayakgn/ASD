@model YKBAfife.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Şifre Değiştir";
}

<section class="account-settings-page">
    <div class="account-settings-card">
        <p class="account-settings-kicker">Hesap Ayarları</p>
        <h1>Şifre Değiştir</h1>
        <p class="account-settings-intro">Mevcut şifrenizi doğrulayarak yeni bir şifre belirleyin.</p>

        @if (TempData["PasswordChanged"] is string successMessage)
        {
            <div class="account-settings-success" role="status">@successMessage</div>
        }

        <form asp-controller="Account" asp-action="ChangePassword" method="post" class="account-settings-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="account-field">
                <label asp-for="CurrentPassword"></label>
                <input asp-for="CurrentPassword" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword"></span>
            </div>
            <div class="account-field">
                <label asp-for="NewPassword"></label>
                <input asp-for="NewPassword" autocomplete="new-password" />
                <span asp-validation-for="NewPassword"></span>
            </div>
            <div class="account-field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
            <div class="account-settings-actions">
                <a asp-controller="Home" asp-action="Index" class="account-cancel">Vazgeç</a>
                <button type="submit" class="account-submit">Şifreyi Güncelle</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
