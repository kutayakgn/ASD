@using YkbAfife.Domain.Model.Data.JuryVoting
@model JuryForgotPasswordViewModel
@{
    Layout = "~/Views/JuryVoting/_JuryVotingLayout.cshtml";
    var forgotPasswordRequested = (ViewData["ForgotPasswordRequested"] as bool?) == true;
}

@section styles {
    <link rel="stylesheet" href="~/css/jury-voting.css" asp-append-version="true" />
}

<div class="d-flex justify-content-center flex-column mb-5 pb-240">
    <div class="m-auto otp-content">
        <h1 class="tag-header-title mb-3">Şifremi Unuttum</h1>
        <form asp-action="ForgotPassword" method="post"
              class="yk-form jury-voting-forgot-password-form gap-3" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-32">
                <label asp-for="Email">E-posta</label>
                <input asp-for="Email" type="email" class="form-control jury-voting-input"
                       placeholder="E-posta adresinizi girin" autocomplete="email"
                       autocapitalize="off" spellcheck="false" maxlength="254" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-dark w-100 jury-voting-button-dark">Şifremi Unuttum</button>
            <div class="pt-3 text-center return-code d-flex align-items-center flex-row justify-content-center">
                <a asp-controller="JuryVoting" asp-action="Login" class="btn text-dark p-0">Giriş ekranına dön</a>
            </div>
        </form>

        @if (forgotPasswordRequested)
        {
            <input type="hidden" id="forgotPasswordRequested" value="true" />
            <input type="hidden" id="forgotPasswordRequestedMessage"
                   value="Mail adresiniz sistemde kayıtlı ise şifre değiştirme bağlantısı iletilmiştir." />
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/jury-voting-forgot-password.js" asp-append-version="true"></script>
}
