@{
    Layout = "~/Views/JuryVoting/_JuryVotingLayout.cshtml";
}

@section styles {
    <link rel="stylesheet" href="~/css/jury-voting.css" asp-append-version="true" />
}

<div class="d-flex justify-content-center flex-column mb-5 pb-240">
    <div class="m-auto otp-content text-center">
        <h1 class="tag-header-title mb-3">Bağlantı Geçersiz</h1>
        <p class="mb-32">Bu şifre sıfırlama bağlantısının süresi dolmuş veya bağlantı daha önce kullanılmıştır.</p>
        <a asp-controller="JuryVoting" asp-action="ForgotPassword"
           class="btn btn-dark w-100 jury-voting-button-dark">Yeni bağlantı iste</a>
    </div>
</div>
