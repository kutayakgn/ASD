@using YkbAfife.Domain.Model.Data.JuryVoting
@model JuryResetPasswordViewModel
@{
    Layout = "~/Views/JuryVoting/_JuryVotingLayout.cshtml";
}

@section styles {
    <link rel="stylesheet" href="~/css/jury-voting.css" asp-append-version="true" />
}

<div class="d-flex justify-content-center flex-column mb-5 pb-240">
    <div class="m-auto otp-content">
        <h1 class="tag-header-title mb-3">Şifre Belirle</h1>
        <p class="mb-32">
            Yeni şifre en az 8 karakter olmalı; büyük harf, küçük harf, rakam ve
            özel karakter (.,*!+-&#64;) içermelidir.
        </p>
        <form asp-action="ResetPassword" method="post"
              class="yk-form jury-voting-reset-password-form gap-3" novalidate>
            @Html.AntiForgeryToken()
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="NewPassword">Yeni Şifre</label>
                <input asp-for="NewPassword" class="form-control jury-voting-input"
                       type="password" placeholder="Yeni şifrenizi girin"
                       autocomplete="new-password" autocapitalize="off" spellcheck="false"
                       minlength="8" maxlength="100" required />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="form-group mb-32">
                <label asp-for="ConfirmPassword">Yeni Şifre Tekrarı</label>
                <input asp-for="ConfirmPassword" class="form-control jury-voting-input"
                       type="password" placeholder="Yeni şifrenizi tekrar girin"
                       autocomplete="new-password" autocapitalize="off" spellcheck="false"
                       minlength="8" maxlength="100" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-dark w-100 jury-voting-button-dark">Kaydet</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/jury-voting-reset-password.js" asp-append-version="true"></script>
}
