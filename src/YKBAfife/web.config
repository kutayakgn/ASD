<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- İki ayrı 150 MB görsel içerebilen duyuru formu için toplam istek sınırı. -->
        <requestLimits maxAllowedContentLength="335544320" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
