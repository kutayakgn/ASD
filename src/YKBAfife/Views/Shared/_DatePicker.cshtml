@model YKBAfife.Models.Components.DatePickerViewModel
@{
    var value = Model.Value?.ToString("yyyy-MM-dd") ?? string.Empty;
    var displayValue = Model.Value?.ToString("dd / MM / yyyy") ?? string.Empty;
    if (Model.IncludeTime && Model.Value.HasValue && Model.TimeValue.HasValue)
    {
        displayValue += " " + Model.TimeValue.Value.ToString("HH:mm");
    }
    var calendarId = $"{Model.Id}-calendar";
}
<div class="add-jury-field application-date-field"
     data-date-picker
     data-initial-date="@value">
    <label for="@(Model.Id)-display">@Model.Label</label>
    <div class="application-date-input">
        <input id="@(Model.Id)-display"
               type="text"
               value="@displayValue"
               placeholder="GG / AA / YYYY"
               readonly
               required="@Model.IsRequired"
               data-date-display
               data-fail-message="@Model.ValidationMessage" />
        <input id="@Model.Id"
               name="@Model.InputName"
               type="hidden"
               value="@value"
               data-date-value
               data-track-change="@Model.TrackChanges"
               data-initial-value="@value" />
        @if (Model.IncludeTime)
        {
            <input id="@(Model.Id)-time" name="@Model.TimeInputName" type="hidden"
                   value="@Model.TimeValue?.ToString("HH:mm")" data-time-value
                   data-track-change="@Model.TrackChanges"
                   data-initial-value="@Model.TimeValue?.ToString("HH:mm")" />
        }
        <button type="button"
                class="application-date-trigger"
                aria-label="@Model.Label takvimini aç"
                aria-expanded="false"
                aria-controls="@calendarId"
                data-date-trigger>
            <img src="~/icons/calendar.svg" alt="" aria-hidden="true" />
        </button>
    </div>

    <div id="@calendarId"
         class="application-calendar@(Model.IncludeTime ? " application-calendar-with-time" : string.Empty)"
         aria-label="@Model.Label seçimi"
         data-date-panel
         hidden>
        <div class="application-calendar-layout">
        <div class="application-calendar-date">
        <div class="application-calendar-header">
            <div class="application-calendar-navigation">
                <button type="button" aria-label="Önceki yıl" data-calendar-action="prev-year">
                    <img src="~/icons/angle-left-solid-full.svg" alt="" aria-hidden="true" />
                    <img src="~/icons/angle-left-solid-full.svg" alt="" aria-hidden="true" />
                </button>
                <button type="button" aria-label="Önceki ay" data-calendar-action="prev-month">
                    <img src="~/icons/angle-left-solid-full.svg" alt="" aria-hidden="true" />
                </button>
            </div>
            <strong aria-live="polite" data-calendar-title>
                <span data-calendar-month></span>
                <select class="application-calendar-year" aria-label="@Model.Label yılı" data-calendar-year></select>
            </strong>
            <div class="application-calendar-navigation">
                <button type="button" aria-label="Sonraki ay" data-calendar-action="next-month">
                    <img src="~/icons/angle-right-solid-full.svg" alt="" aria-hidden="true" />
                </button>
                <button type="button" aria-label="Sonraki yıl" data-calendar-action="next-year">
                    <img src="~/icons/angle-right-solid-full.svg" alt="" aria-hidden="true" />
                    <img src="~/icons/angle-right-solid-full.svg" alt="" aria-hidden="true" />
                </button>
            </div>
        </div>
        <div class="application-calendar-weekdays" aria-hidden="true">
            <span>Pzt</span><span>Sal</span><span>Çar</span><span>Per</span>
            <span>Cum</span><span>Cmt</span><span>Paz</span>
        </div>
        <div class="application-calendar-days" role="grid" data-calendar-days></div>
        </div>
            @if (Model.IncludeTime)
            {
                <div class="application-calendar-time">
                    <div class="application-calendar-time-header">
                        <strong aria-live="polite" data-calendar-time-title>@(Model.TimeValue?.ToString("HH:mm") ?? "--:--")</strong>
                    </div>
                    <div class="application-calendar-time-columns">
                    <div class="application-calendar-time-column">
                    <label for="@(Model.Id)-hour">Saat</label>
                    <select id="@(Model.Id)-hour" size="8" aria-label="@Model.Label saati" data-calendar-hour>
                        <option value="">—</option>
                        @for (var hour = 0; hour < 24; hour++)
                        {
                            <option value="@hour.ToString("00")" selected="@(Model.TimeValue?.Hour == hour)">@hour.ToString("00")</option>
                        }
                    </select>
                    </div>
                    <div class="application-calendar-time-column">
                    <label for="@(Model.Id)-minute">Dakika</label>
                    <select id="@(Model.Id)-minute" size="8" aria-label="@Model.Label dakikası" data-calendar-minute>
                        <option value="">—</option>
                        @for (var minute = 0; minute < 60; minute++)
                        {
                            <option value="@minute.ToString("00")" selected="@(Model.TimeValue?.Minute == minute)">@minute.ToString("00")</option>
                        }
                    </select>
                    </div>
                    </div>
                </div>
            }
        </div>
        <div class="application-calendar-footer gap-2">
            @if (Model.AllowClear && !Model.IsRequired)
            {
                <button type="button" class="application-calendar-apply" data-calendar-clear>Tarihi Temizle</button>
            }
            <button type="button" class="application-calendar-apply" data-calendar-apply>  @(Model.IncludeTime ? "Tarih ve Saat Seç" :"Tarih Seç") </button>
        </div>
    </div>
</div>
