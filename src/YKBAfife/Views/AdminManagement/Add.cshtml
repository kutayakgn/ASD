@model YKBAfife.Models.ViewModels.AddAdminViewModel
@{
    ViewData["Title"] = "Admin Ekle";
}

<section class="play-details-page add-jury-page admin-form-page">
    <a asp-action="Index" class="play-details-back">
        <img src="~/icons/angle-left-solid-full.svg" alt="" aria-hidden="true" />
        <span>Admin Y&#246;netimine D&#246;n</span>
    </a>

    <header class="play-details-toolbar">
        <h1>Admin Ekle</h1>
    </header>

    <form asp-action="Add"
          method="post"
          class="add-jury-form"
          novalidate
          data-admin-form
          data-generic-confirm
          data-confirm-message="Admin eklemek istedi&#287;inize emin misiniz?"
          data-confirm-text="Evet"
          data-cancel-text="&#304;ptal">
        @Html.AntiForgeryToken()
        <div class="add-jury-grid">
            <div class="add-jury-field">
                <label asp-for="Username"></label>
                <input asp-for="Username" required minlength="3" maxlength="100"
                       autocomplete="username" pattern="[A-Za-z0-9&#199;&#286;&#304;&#214;&#350;&#220;&#231;&#287;&#305;&#246;&#351;&#252;._-]+" data-fail-message="Kullan&#305;c&#305; ad&#305; bo&#351;luk veya ._- d&#305;&#351;&#305;nda noktalama i&#351;areti i&#231;eremez." />
            </div>
            <div class="add-jury-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" required maxlength="255"
                       autocomplete="email" pattern="[A-Za-z0-9._%+\-]+@@[A-Za-z0-9.-]+\.[A-Za-z]{2,}" data-fail-message="E-posta adresi T&#252;rk&#231;e karakter i&#231;eremez ve ge&#231;erli formatta olmal&#305;d&#305;r." />
            </div>
            <div class="add-jury-field">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" required minlength="3" maxlength="201"
                       pattern=".*\S+\s+\S+.*" autocomplete="name"
                       data-fail-message="Ad ve soyad bilgisini birlikte giriniz." />
            </div>
            <div class="add-jury-field">
                <label asp-for="Password"></label>
                <input asp-for="Password" type="text" required minlength="8" maxlength="100"
                       autocomplete="new-password" data-fail-message="&#350;ifre en az 8 karakter olmal&#305;d&#305;r." />
            </div>
            <fieldset class="add-jury-status admin-status-field">
                <legend>Stat&#252;</legend>
                <div class="add-jury-status-options">
                    <label class="add-jury-option">
                        <input type="radio" asp-for="IsActive" value="true" required />
                        <span>Aktif</span>
                    </label>
                    <label class="add-jury-option">
                        <input type="radio" asp-for="IsActive" value="false" required />
                        <span>Aktif De&#287;il</span>
                    </label>
                </div>
            </fieldset>
        </div>

        <div class="add-jury-actions">
            <a asp-action="Index" class="add-jury-cancel" data-history-back>&#304;ptal</a>
            <button type="submit" class="add-jury-submit">Kaydet</button>
        </div>
    </form>
</section>

@section Scripts {
    <script src="~/js/add-admin.js" asp-append-version="true"></script>
}
