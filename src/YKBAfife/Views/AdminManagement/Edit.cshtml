@model YKBAfife.Models.ViewModels.EditAdminViewModel
@{
    ViewData["Title"] = "Admin D&#252;zenle";
}

<section class="play-details-page add-jury-page admin-form-page">
    <a asp-action="Details" asp-route-id="@Model.Id" class="play-details-back">
        <img src="~/icons/arrow-left.svg" alt="" aria-hidden="true" />
        <span>Admin Detay' a Dön</span>
    </a>

    <header class="play-details-toolbar">
        <h1>Admin D&#252;zenle</h1>
    </header>

    <form asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          class="add-jury-form"
          novalidate
          data-admin-form
          data-admin-edit-form
          data-initial-username="@Model.Username"
          data-initial-email="@Model.Email"
          data-initial-full-name="@Model.FullName"
          data-initial-active="@Model.IsActive?.ToString().ToLowerInvariant()"
          data-generic-confirm
          data-confirm-message="Admin bilgilerini g&#252;ncellemek istedi&#287;inize emin misiniz?"
          data-confirm-text="Evet"
          data-cancel-text="&#304;ptal">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />

        <div class="add-jury-grid">
            <div class="add-jury-field">
                <label asp-for="Username"></label>
                <input asp-for="Username" required minlength="3" maxlength="30"
                       autocomplete="username"
                       pattern="[A-Za-z0-9._]+"
                       data-fail-message="Kullan&#305;c&#305; ad&#305; yaln&#305;zca &#304;ngilizce harf, rakam, nokta ve alt &#231;izgi i&#231;erebilir; bo&#351;luk i&#231;eremez." />
            </div>
            <div class="add-jury-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" required maxlength="255"
                       autocomplete="email"
                       pattern="[A-Za-z0-9._%+\-]+@@[A-Za-z0-9.-]+\.[A-Za-z]{2,}"
                       data-fail-message="E-posta adresi T&#252;rk&#231;e karakter i&#231;eremez ve ge&#231;erli formatta olmal&#305;d&#305;r." />
            </div>
            <div class="add-jury-field">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" required minlength="3" maxlength="201"
                       pattern=".*\S+\s+\S+.*" autocomplete="name"
                       data-fail-message="Ad ve soyad bilgisini birlikte giriniz." />
            </div>
            <div class="add-jury-field">
                <label asp-for="Password"></label>
                <div class="edit-password" data-edit-password>
                <input asp-for="Password" value="" type="password" minlength="8" maxlength="100"
                       pattern="@YKBAfife.Helpers.PasswordPolicy.Pattern"
                       autocomplete="new-password" placeholder="••••••••"
                       aria-describedby="password-help" data-edit-password-input
                       data-fail-message="@YKBAfife.Helpers.PasswordPolicy.ErrorMessage" />
                    <button type="button" class="edit-password-toggle" data-edit-password-toggle
                            aria-label="Yeni şifreyi göster" aria-pressed="false" disabled>
                        <img src="~/icons/eye.svg" alt="" aria-hidden="true" />
                    </button>
                </div>
                <small id="password-help" class="edit-password-help">Mevcut şifre korunur. Değiştirmek için yeni şifre yazın; göz simgesi yeni şifreyi gösterir.</small>
            </div>
            @if (Model.CanEditStatus)

            {
<fieldset class="add-jury-status admin-status-field">
                <legend>Stat&#252;</legend>
                <div class="add-jury-status-options">
                    <label class="add-jury-option">
                        <input type="radio" asp-for="IsActive" value="true" required />
                        <span>Aktif</span>
                    </label>
                    <label class="add-jury-option">
                        <input type="radio" asp-for="IsActive" value="false" required />
                        <span>Aktif De&#287;il</span>
                    </label>
                </div>
            </fieldset>

            }
        </div>

        <div class="add-jury-actions">
            <a asp-action="Details" asp-route-id="@Model.Id" class="add-jury-cancel">&#304;ptal</a>
            <button type="submit" class="add-jury-submit">Kaydet</button>
        </div>
    </form>
</section>

@section Scripts {
    <script src="~/js/add-admin.js" asp-append-version="true"></script>
    <script src="~/js/edit-password.js" asp-append-version="true"></script>
}
