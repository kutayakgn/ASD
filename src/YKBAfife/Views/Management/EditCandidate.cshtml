@using System.Text.Json
@model YKBAfife.Models.ViewModels.EditCandidateViewModel
@{
    ViewData["Title"] = "Adayı Düzenle";
}
<section class="play-details-page add-jury-page edit-candidate-page">
    <a asp-action="CandidateDetails" asp-route-id="@Model.Id" class="play-details-back">
        <img src="~/icons/angle-left-solid-full.svg" alt="" aria-hidden="true" />
        <span>Aday Detayına Dön</span>
    </a>

    <header class="play-details-toolbar">
        <h1>Adayı Düzenle</h1>
    </header>

    <form asp-action="EditCandidate"
          asp-route-id="@Model.Id"
          method="post"
          enctype="multipart/form-data"
          class="add-jury-form"
          novalidate
          data-edit-candidate-form>
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="RemovePhoto" type="hidden" data-jury-remove-photo />
        <input asp-for="ConfirmRoleGroupUpdate" type="hidden" data-confirm-role-group-update />
        <input asp-for="OriginalRole" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="add-jury-validation-summary" role="alert"></div>

        <div class="add-jury-grid">
            <div class="add-jury-field">
                <label for="candidate-play-name">Oyun Adı</label>
                <input id="candidate-play-name" value="@Model.PlayName" disabled />
            </div>
            <div class="add-jury-field">
                <label for="candidate-category-name">Ödül Kategorisi</label>
                <input id="candidate-category-name" value="@Model.CategoryName" disabled />
            </div>
            <div class="add-jury-field">
                <label asp-for="Candidate"></label>
                <input asp-for="Candidate" required minlength="2" maxlength="250" autocomplete="name" />
                <span asp-validation-for="Candidate"></span>
            </div>
            @if (Model.HasRoleAndPhoto)
            {
                <div class="add-jury-field">
                    <label asp-for="Role"></label>
                    <input asp-for="Role" required maxlength="200" />
                    <span asp-validation-for="Role"></span>
                </div>
            }
            <fieldset class="add-jury-status">
                <legend>Statü</legend>
                <div class="add-jury-status-options">
                    <label class="add-jury-option">
                        <input type="radio" asp-for="IsActive" value="true" required />
                        <span>Aktif</span>
                    </label>
                    <label class="add-jury-option">
                        <input type="radio" asp-for="IsActive" value="false" required />
                        <span>Aktif Değil</span>
                    </label>
                </div>
                <span asp-validation-for="IsActive"></span>
            </fieldset>

            @if (Model.HasRoleAndPhoto)
            {
                <div class="add-jury-field add-jury-photo-field">
                    <label asp-for="Photo"></label>
                    <div class="add-jury-upload" data-jury-upload-control>
                        <button type="button" class="add-jury-upload-picker"
                                aria-label="Fotoğraf dosyası seç" data-jury-photo-picker>
                            <span data-jury-file-name>@(Model.HasExistingPhoto ? Model.ExistingPhotoFileName : "Dosya Yükle")</span>
                        </button>
                        <button type="button" class="add-jury-upload-icon"
                                aria-label="Dosya yükle" data-jury-photo-primary>
                            <img src="~/icons/upload.svg" alt="" aria-hidden="true" data-jury-photo-primary-icon />
                        </button>
                    </div>
                    <input id="candidate-photo-input"
                           asp-for="Photo"
                           type="file"
                           class="visually-hidden"
                           accept="image/jpeg,image/png,image/webp"
                           data-jury-photo-input
                           data-existing-photo-url="@Model.ExistingPhotoUrl"
                           data-existing-photo-name="@Model.ExistingPhotoFileName" />
                    <div class="add-jury-photo-actions" data-jury-photo-actions hidden>
                        <button type="button" class="add-jury-photo-action" data-jury-photo-view>
                            <img src="~/icons/eye.svg" alt="" aria-hidden="true" />
                            <span>Fotoğrafı Görüntüle</span>
                        </button>
                        <button type="button" class="add-jury-photo-action" data-jury-photo-replace>
                            <img src="~/icons/upload.svg" alt="" aria-hidden="true" />
                            <span>Farklı Fotoğraf Ekle</span>
                        </button>
                    </div>
                    <span asp-validation-for="Photo"></span>
                </div>
            }
        </div>

        <div class="add-jury-actions">
            <a asp-action="CandidateDetails" asp-route-id="@Model.Id" class="add-jury-cancel">İptal</a>
            <button type="submit" class="add-jury-submit">Kaydet</button>
        </div>
    </form>

    @if (Model.HasRoleAndPhoto)
    {
        <div class="add-jury-photo-modal" data-jury-photo-modal hidden>
            <div class="add-jury-photo-dialog" role="dialog" aria-modal="true" aria-label="Fotoğraf önizleme">
                <img src="" alt="Aday fotoğrafı önizlemesi" data-jury-photo-preview />
            </div>
        </div>
    }

    <script type="application/json" data-edit-candidate-other-roles>@Html.Raw(JsonSerializer.Serialize(Model.OtherRoleNames))</script>
    <script type="application/json" data-edit-candidate-related-candidates>@Html.Raw(JsonSerializer.Serialize(Model.RelatedCandidates))</script>
</section>

@section Scripts {
    @if (Model.HasRoleAndPhoto)
    {
        <script src="~/js/add-jury.js" asp-append-version="true"></script>
    }
    <script src="~/js/edit-candidate.js" asp-append-version="true"></script>
}
