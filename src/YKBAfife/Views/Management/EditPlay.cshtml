@model YKBAfife.Models.ViewModels.EditPlayViewModel
@{
    ViewData["Title"] = "Oyunu Düzenle";
}
<section class="play-details-page add-jury-page add-play-page" aria-labelledby="edit-play-title">
    <a asp-action="PlayDetails"
       asp-route-slug="@Model.Slug"
       asp-route-returnUrl="@Model.ReturnUrl"
       class="play-details-back">
        <img src="~/icons/arrow-left.svg" alt="" aria-hidden="true" />
        <span>Oyun Detay' a Dön</span>
    </a>
    <header class="play-details-toolbar"><h1 id="edit-play-title">Oyunu Düzenle</h1></header>

    <form asp-action="EditPlay" asp-route-slug="@Model.Slug" method="post"
          class="add-jury-form add-play-form" novalidate
          data-add-play-form data-confirm-message="Oyunu güncellemek istediğinize emin misiniz?"
          data-similarity-check-url="@Url.Action("CheckPlaySimilarity", "Management")">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="RecordType" type="hidden" />
        <input asp-for="ReturnUrl" type="hidden" />
        <input asp-for="ConfirmSimilarPlay" type="hidden" data-confirm-similar-play />
        <div asp-validation-summary="ModelOnly" class="add-jury-validation-summary" role="alert"></div>

        <partial name="_PlayFormFields" model="Model" />

        <div class="add-jury-actions">
            <a asp-action="PlayDetails"
               asp-route-slug="@Model.Slug"
               asp-route-returnUrl="@Model.ReturnUrl"
               class="add-jury-cancel">İptal</a>
            <button type="submit" class="add-jury-submit">Kaydet</button>
        </div>
    </form>
</section>
@section Scripts { <script src="~/js/add-play.js" asp-append-version="true"></script> }
