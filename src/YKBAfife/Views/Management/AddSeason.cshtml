@model YKBAfife.Models.ViewModels.SeasonFormViewModel
@{
    ViewData["Title"] = "Sezon Ekle";
}

<section class="play-details-page add-jury-page season-form-page" aria-labelledby="add-season-title">
    <a asp-action="VotingSettings" class="play-details-back">
        <img src="~/icons/arrow-left.svg" alt="" aria-hidden="true" />
        <span>Diğer Ayarlar' a Dön</span>
    </a>

    <header class="play-details-toolbar">
        <h1 id="add-season-title">Sezon Ekle</h1>
    </header>

    <form asp-action="AddSeason"
          method="post"
          class="add-jury-form season-form"
          novalidate
          data-season-form
          data-season-form-mode="add"
          data-confirm-message="Sezonu eklemek istediğinize emin misiniz?">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="add-jury-validation-summary" role="alert"></div>
        <partial name="_SeasonFormFields" model="Model" />
        <div class="add-jury-actions">
            <a asp-action="VotingSettings" class="add-jury-cancel">İptal</a>
            <button type="submit" class="add-jury-submit">Kaydet</button>
        </div>
    </form>
</section>

@section Scripts {
    <script src="~/js/date-picker.js" asp-append-version="true"></script>
    <script src="~/js/season-form.js" asp-append-version="true"></script>
}
