@model YKBAfife.Models.ViewModels.AddPlayViewModel
@{
    ViewData["Title"] = "Oyun Ekle";
}

<section class="play-details-page add-jury-page add-play-page" aria-labelledby="add-play-title">
    <a asp-action="Plays" class="play-details-back">
        <img src="~/icons/arrow-left.svg" alt="" aria-hidden="true" />
        <span>Oyunlar' a Dön</span>
    </a>

    <header class="play-details-toolbar">
        <h1 id="add-play-title">Oyun Ekle</h1>
    </header>

    <form asp-action="AddPlay" method="post" class="add-jury-form add-play-form" novalidate
          data-add-play-form
          data-similarity-check-url="@Url.Action("CheckPlaySimilarity", "Management")">
        @Html.AntiForgeryToken()
        <input asp-for="ConfirmSimilarPlay" type="hidden" data-confirm-similar-play />
        <div asp-validation-summary="ModelOnly" class="add-jury-validation-summary" role="alert"></div>
        <partial name="_PlayFormFields" model="Model" />

        <div class="add-jury-actions">
            <a asp-action="Plays" class="add-jury-cancel" data-history-back>İptal</a>
            <button type="submit" class="add-jury-submit">Kaydet</button>
        </div>
    </form>
</section>

@section Scripts {
    <script src="~/js/add-play.js" asp-append-version="true"></script>
}
