@model YKBAfife.Models.ViewModels.AddBlacklistViewModel
@{
    ViewData["Title"] = "Blacklist Ekle";
}

<section class="play-details-page add-jury-page" aria-labelledby="blacklist-form-title">
    <a asp-action="Blacklists" class="play-details-back">
        <img src="~/icons/angle-left-solid-full.svg" alt="" aria-hidden="true" />
        <span>Blacklistlere D&#246;n</span>
    </a>

    <header class="play-details-toolbar">
        <h1 id="blacklist-form-title">Blacklist Ekle</h1>
    </header>

    <form asp-action="AddBlacklist"
          method="post"
          class="add-jury-form"
          data-generic-confirm
          data-confirm-message="Blacklist kayd&#305;n&#305; eklemek istedi&#287;inize emin misiniz?">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="add-jury-validation-summary" role="alert"></div>

        <div class="add-jury-grid">
            <div class="add-jury-field">
                <partial name="_LazySearchSelect" model="@(new YKBAfife.Models.Components.LazySearchSelectViewModel
                {
                    Id = "blacklist-play",
                    InputName = nameof(Model.PlayId),
                    Label = "Oyun",
                    Placeholder = "Oyun Seçin",
                    SearchPlaceholder = "Oyun Ara",
                    Endpoint = Url.Action("PlayOptions", "Management") ?? "/secenekler/oyunlar",
                    SelectedValue = Model.PlayId,
                    SelectedText = Model.PlayName,
                    IsRequired = true
                })" />
                <span asp-validation-for="PlayId"></span>
            </div>
            <div class="add-jury-field">
                <partial name="_LazySearchSelect" model="@(new YKBAfife.Models.Components.LazySearchSelectViewModel
                {
                    Id = "blacklist-jury",
                    InputName = nameof(Model.JuryId),
                    Label = "Jüri",
                    Placeholder = "Jüri Seçin",
                    SearchPlaceholder = "Jüri Ara",
                    Endpoint = Url.Action("JuryOptions", "Management") ?? "/secenekler/juriler",
                    SelectedValue = Model.JuryId,
                    SelectedText = Model.JuryName,
                    IsRequired = true
                })" />
                <span asp-validation-for="JuryId"></span>
            </div>
        </div>

        <div class="add-jury-actions">
            <a asp-action="Blacklists" class="add-jury-cancel" data-history-back>&#304;ptal</a>
            <button type="submit" class="add-jury-submit">Kaydet</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/lazy-search-select.js" asp-append-version="true"></script>
}
