@model YKBAfife.Models.ViewModels.VotingSettingsViewModel
@{
    ViewData["Title"] = "Diğer Ayarlar";
}
<section class="season-settings-page" aria-label="Diğer Ayarlar">
    <h2 class="season-settings-page-header">Diğer Ayarlar</h2>
    <div class="settings-accordion" data-settings-accordion>
        <section class="settings-accordion-item" data-settings-section>
            <h2 class="settings-accordion-heading">
                <button type="button" class="settings-accordion-trigger" aria-expanded="false" aria-controls="season-settings-content" data-settings-trigger>
                    <span>Sezon Ayarları</span><img src="~/icons/angle-down.svg" alt="" aria-hidden="true" />
                </button>
            </h2>
            <div id="season-settings-content" class="settings-accordion-content" data-settings-content hidden>
                <div class="settings-accordion-content-inner">
                    @await Component.InvokeAsync("ComplexTable", new { model = Model.SeasonTable })
                </div>
            </div>
        </section>
        <section class="settings-accordion-item" data-settings-section>
            <h2 class="settings-accordion-heading">
                <button type="button" class="settings-accordion-trigger" aria-expanded="false" aria-controls="additional-voting-settings-content" data-settings-trigger>
                    <span>Ek Oylama/Oy Düzenleme Hakkı</span><img src="~/icons/angle-down.svg" alt="" aria-hidden="true" />
                </button>
            </h2>
            <div id="additional-voting-settings-content" class="settings-accordion-content" data-settings-content hidden>
                <div class="settings-accordion-content-inner">
                    @await Component.InvokeAsync("ComplexTable", new { model = Model.AdditionalVotingTable })
                </div>
            </div>
        </section>
        <section class="settings-accordion-item" data-settings-section>
            <h2 class="settings-accordion-heading">
                <button type="button" class="settings-accordion-trigger" aria-expanded="false" aria-controls="play-status-settings-content" data-settings-trigger>
                    <span>Oyun Statüleri</span><img src="~/icons/angle-down.svg" alt="" aria-hidden="true" />
                </button>
            </h2>
            <div id="play-status-settings-content" class="settings-accordion-content" data-settings-content hidden>
                <div class="settings-accordion-content-inner">
                    @await Component.InvokeAsync("ComplexTable", new { model = Model.PlayStatusTable })
                </div>
            </div>
        </section>
        <section class="settings-accordion-item" data-settings-section>
            <h2 class="settings-accordion-heading">
                <button type="button" class="settings-accordion-trigger" aria-expanded="false" aria-controls="announcement-settings-content" data-settings-trigger>
                    <span>Duyurular</span><img src="~/icons/angle-down.svg" alt="" aria-hidden="true" />
                </button>
            </h2>
            <div id="announcement-settings-content" class="settings-accordion-content" data-settings-content hidden>
                <div class="settings-accordion-content-inner">
                    @await Component.InvokeAsync("ComplexTable", new { model = Model.AnnouncementTable })
                </div>
            </div>
        </section>
        <section class="settings-accordion-item" data-settings-section>
            <h2 class="settings-accordion-heading">
                <button type="button" class="settings-accordion-trigger" aria-expanded="false" aria-controls="jury-home-page-table-settings-content" data-settings-trigger>
                    <span>Jüri Paneli Ana Ekran Tabloları</span><img src="~/icons/angle-down.svg" alt="" aria-hidden="true" />
                </button>
            </h2>
            <div id="jury-home-page-table-settings-content" class="settings-accordion-content" data-settings-content hidden>
                <div class="settings-accordion-content-inner">
                    @await Component.InvokeAsync("ComplexTable", new { model = Model.JuryHomePageTable })
                </div>
            </div>
        </section>
        <section class="settings-accordion-item" data-settings-section>
            <h2 class="settings-accordion-heading">
                <button type="button" class="settings-accordion-trigger" aria-expanded="false" aria-controls="birthday-settings-content" data-settings-trigger>
                    <span>Doğum Günü Ayarları</span><img src="~/icons/angle-down.svg" alt="" aria-hidden="true" />
                </button>
            </h2>
            <div id="birthday-settings-content" class="settings-accordion-content" data-settings-content hidden>
                <div class="settings-accordion-content-inner">
                    <form asp-action="SaveBirthdaySettings" method="post" class="add-jury-form birthday-settings-form" data-birthday-settings-form novalidate>
                        @Html.AntiForgeryToken()
                        <div class="birthday-settings-grid">
                            <div class="add-jury-field">
                                <label for="birthday-settings-message">Mesaj</label>
                                <input id="birthday-settings-message" name="Message" type="text" value="@Model.BirthdaySettings.Message"
                                       maxlength="200" required aria-describedby="birthday-settings-message-error" />
                                <span id="birthday-settings-message-error" class="field-validation-error" data-birthday-settings-error="Message"></span>
                            </div>
                            <div class="add-jury-field">
                                <label for="birthday-settings-days">Gösterim Süresi (Gün)</label>
                                <input id="birthday-settings-days" name="DisplayDays" type="number" value="@Model.BirthdaySettings.DisplayDays"
                                       min="0" max="10" step="1" required aria-describedby="birthday-settings-days-error" />
                                <span id="birthday-settings-days-error" class="field-validation-error" data-birthday-settings-error="DisplayDays"></span>
                            </div>
                        </div>
                        <p class="birthday-settings-result" role="status" aria-live="polite" data-birthday-settings-result></p>
                        <div class="add-jury-actions">
                            <button type="submit" class="add-jury-submit">Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </section>
        <section class="settings-accordion-item" data-settings-section>
            <h2 class="settings-accordion-heading">
                <button type="button" class="settings-accordion-trigger" aria-expanded="false" aria-controls="group-settings-content" data-settings-trigger>
                    <span>Jüri Grupları</span><img src="~/icons/angle-down.svg" alt="" aria-hidden="true" />
                </button>
            </h2>
            <div id="group-settings-content" class="settings-accordion-content" data-settings-content hidden>
                <div class="settings-accordion-content-inner">
                    @await Component.InvokeAsync("ComplexTable", new { model = Model.GroupTable })
                </div>
            </div>
        </section>
    </div>
</section>

@section Scripts {
    <script src="~/js/settings-accordion.js" asp-append-version="true"></script>
    <script src="~/js/birthday-settings.js" asp-append-version="true"></script>
}
