@model YKBAfife.Models.ViewModels.RankingVoteModalViewModel

<div class="modal fade play-viewers-modal ranking-votes-modal"
     id="rankingVotesModal" tabindex="-1" aria-labelledby="rankingVotesModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <header class="modal-header play-viewers-modal-header">
                <p id="rankingVotesModalTitle">@Model.PlayName</p>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </header>
            <div class="modal-body play-viewers-modal-body">
                @await Component.InvokeAsync("ComplexTable", new { model = Model.Table })
            </div>
        </div>
    </div>
</div>
